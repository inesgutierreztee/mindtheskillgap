# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# LTA_ACCOUNT_KEY: Free AccountKey from LTA DataMall (https://datamall.lta.gov.sg/).
# Required for live bus arrivals, train status, and crowd data.
# Without it, the app falls back to bundled demo data and the UI shows "DEMO DATA" instead of "LIVE".
LTA_ACCOUNT_KEY="MY_LTA_ACCOUNT_KEY"

# OneMap (free account at https://www.onemap.gov.sg/apidocs/register) powers real
# public-transit route planning (walk + bus + train) and cycling routes between
# recognised Singapore locations. Without either option below, transit falls
# back to bundled demo routes; cycling stays unavailable rather than showing
# synthetic data as live.
#
# Option A — paste a token you already generated from OneMap's own portal.
# Simplest, but expires after ~3 days and needs manually refreshing.
ONEMAP_TOKEN="MY_ONEMAP_TOKEN"
#
# Option B — email/password so the server auto-fetches and refreshes tokens
# itself. Used only if ONEMAP_TOKEN above is not set.
# ONEMAP_EMAIL="MY_ONEMAP_EMAIL"
# ONEMAP_PASSWORD="MY_ONEMAP_PASSWORD"
